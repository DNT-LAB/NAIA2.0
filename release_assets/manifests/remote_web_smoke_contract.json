  "websocket_checks": [
    {
      "feature": "startup_state",
      "path": "/ws",
      "expected_initial_types": [
        "session",
        "mode",
        "options",
        "params",
        "queue_state",
        "api_status",
        "init_complete",
        "lazy_indices_ready",
        "anlas_update"
      ],
      "sync_message": "sync",
      "expected_sync_type": "mode"
    },
    {
      "feature": "command_flow_random_generate",
      "path": "/ws",
      "expected_initial_types": [
        "session",
        "mode",
        "options",
        "params",
        "queue_state",
        "api_status",
        "init_complete",
        "lazy_indices_ready",
        "anlas_update"
      ],
      "commands": [
        {
          "name": "set_prompt_sync",
          "send_json": {
            "type": "set_prompt",
            "prompt": "naia websocket smoke prompt",
            "negative_prompt": "low quality"
          },
          "expected_messages": [
            {
              "type": "prompt_sync",
              "expected_json_subset": {
                "prompt": "naia websocket smoke prompt",
                "negative": "low quality"
              }
            }
          ]
        },
        {
          "name": "set_param_steps",
          "send_json": {
            "type": "set_param",
            "key": "steps",
            "value": 12
          },
          "expected_messages": [
            {
              "type": "params",
              "expected_json_subset": {
                "steps": 12
              }
            }
          ]
        },
        {
          "name": "warmed_random_prompt",
          "send_json": {
            "type": "random",
            "random_request_id": "smoke-random-1",
            "ratings": ["s"],
            "overrides": {
              "auto_generate": false
            }
          },
          "max_latency_ms": 200,
          "expected_messages": [
            {
              "type": "prompt_generated",
              "expected_json_subset": {
                "source": "random",
                "requestId": "smoke-random-1"
              },
              "expected_json_keys": ["prompt", "prompt_run_id", "rating_counts"]
            },
            {
              "type": "module_state",
              "expected_json_subset": {
                "module_id": "wildcard",
                "runtime": "web",
                "live_update": true
              },
              "expected_json_keys": ["state"]
            }
          ]
        },
        {
          "name": "generate_dispatch_queued",
          "send_json": {
            "type": "generate",
            "api_mode": "NAI",
            "prompt": "naia websocket smoke prompt",
            "negative_prompt": "low quality",
            "overrides": {
              "input": "naia websocket smoke prompt",
              "_raw_input": "naia websocket smoke prompt",
              "api_mode": "NAI",
              "seed": 12345
            }
          },
          "expected_messages": [
            {
              "type": "generation_dispatched",
              "expected_json_subset": {
                "ok": true,
                "api_mode": "NAI",
                "queued": true
              },
              "expected_json_keys": ["generation_request_id", "prompt_run_id"]
            },
            {
              "type": "status",
              "expected_json_subset": {
                "is_generating": false,
                "message": "queued"
              }
            },
            {
              "type": "queue_state",
              "expected_json_subset": {
                "total": 1
              },
              "expected_json_keys": ["items"]
            }
          ]
        }
      ]
    },
    {
      "feature": "module_surface_states",
      "path": "/ws",
      "expected_initial_types": [
        "session",
        "mode",
        "options",
        "params",
        "queue_state",
