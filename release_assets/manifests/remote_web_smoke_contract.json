          "send_json": {
            "type": "get_module_state",
            "module_id": "wildcard_status"
          },
          "expected_messages": [
            {
              "type": "module_state",
              "expected_json_subset": {
                "module_id": "wildcard_status",
                "runtime": "web",
                "retired": true
