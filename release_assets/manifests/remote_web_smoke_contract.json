{
  "version": 1,
  "status": "draft",
  "scope": "non-destructive Remote Web smoke checks for staged backend resources",
  "notes": [
    "This contract intentionally avoids NovelAI/WebUI/ComfyUI generation dispatch and external network side effects.",
    "Non-destructive checks cover the route surfaces needed by Remote Web panels; live image generation and external APIs remain separate validation.",
    "Full packaged-app validation must still test Generate, Enhance, img2img, Vibe Transfer, Character Reference, Artist Thumb, and setup/API workflows with real runtime credentials or controlled test doubles.",
    "On connect the server sends the startup state messages and then one anlas_update (the NAI Anlas pill snapshot), broadcast before the command receive loop. expected_initial_types lists anlas_update last to keep command/response alignment deterministic."
  ],
  "test_tokens": {
    "nai_token": "naia-smoke-token"
  },
  "seed_context": {
    "prompt": "naia websocket smoke prompt",
    "negative_prompt": "low quality",
    "warmup_random": true,
    "search_results": [
      {
        "rating": "s",
        "general": "1girl, solo, simple background",
        "artist": "",
        "character": "",
        "copyright": "",
        "meta": ""
      }
    ],
    "module_storage": {
      "character_reference": [
        {
          "file_hash": "smoke_char_ref_thumb",
          "size": [32, 24],
          "color": [120, 30, 200]
        }
      ],
      "vibe_transfer": [
        {
          "model": "NAID4_5",
          "file_hash": "smoke_vibe_thumb",
          "size": [24, 32],
          "color": [30, 180, 90]
        }
      ]
    }
  },
