  "data_dependencies": [
    {
      "feature": "character_asset",
      "description": "Creation bench random slot pools (one comma-separated tag set per line).",
      "paths": ["data/random_character.txt", "data/random_outfits.txt"],
      "provisioning": "bundled"
    },
    {
      "feature": "core_status_queue",
      "description": "Core filter dictionaries shipped as small bootstrap text/json.",
      "paths": ["data/clothes_list.txt", "data/color.txt", "data/characteristic_list.txt"],
      "provisioning": "bundled"
    },
    {
      "feature": "presets",
      "description": "Clothes preset library bundled with the headless core tree.",
      "paths": ["core/clothes_preset/**"],
      "provisioning": "bundled"
    },
    {
      "feature": "presets",
      "description": "Event preset prompt/thumbnail assets fetched from the release mirror at runtime.",
      "paths": ["data/event_preset/**"],
      "provisioning": "downloader",
      "provisioned_by": "POST /api/event-preset/download"
    },
    {
      "feature": "prompt_tools",
      "description": "Style thumbnail catalog bundled in the tag list payload.",
      "paths": ["data/taglist/*.json"],
      "provisioning": "bundled"
    },
    {
      "feature": "prompt_tools",
      "description": "Tag search / autocomplete KR corpus, metadata fallback index, and artist/character/copyright dictionaries bundled for clean-machine autocomplete.",
      "paths": [
        "data/KR_tags.parquet",
        "data/e621_KR_tags.parquet",
        "data/interactive_tags.json",
        "data/tag_index/**",
        "artist_dictionary.py",
        "danbooru_character.py",
        "result_dict_copyright.py"
      ],
      "provisioning": "bundled"
    },
    {
      "feature": "install_manager",
      "description": "Tag search parquet archive downloaded by the first-run install manager.",
      "paths": ["data/tags/**"],
      "provisioning": "downloader",
      "provisioned_by": "POST /api/install-manager/tag-archive/download"
    },
    {
      "feature": "install_manager",
      "description": "Event corpus (.tgp) tag co-occurrence partitions for Interactive mode recommendations. Absent on a clean install; Interactive still works for direct tag entry, only the recommendation panel reports state=missing.",
      "paths": ["data/quick_search/**"],
      "provisioning": "downloader",
      "provisioned_by": "POST /api/install-manager/corpus-archive/download"
    },
    {
      "feature": "thumb_character_viewer",
      "description": "Character Viewer copyright groups + character analysis bundled for clean-machine availability (thumbnails remain optional/runtime).",
      "paths": ["data/copyright_groups.json", "data/character_analysis.json"],
      "provisioning": "bundled"
    },
    {
      "feature": "websocket_shared_state",
      "description": "E621 Event module corpus bundled for clean-machine availability (module driven through WebSocket module commands).",
      "paths": ["data/e621_data"],
      "provisioning": "bundled"
    },
    {
      "feature": "artist_thumbnail",
      "description": "Artist thumbnail catalog and images fetched at runtime.",
      "paths": ["data/artist_thumbnail_choices.json"],
      "provisioning": "downloader",
      "provisioned_by": "POST /api/artist-thumb/download"
    },
    {
      "feature": "character_viewer_thumbnail",
      "description": "Character viewer thumbnails generated by the user. Written under the user data root, never the install tree.",
      "paths": ["<user-data>/data/character_thumbnails/**"],
      "provisioning": "runtime_generated",
      "provisioned_by": "POST /api/character-viewer/thumbnail"
    },
    {
      "feature": "interactive_mode",
      "description": "Interactive thumbnail pack (<axis>/<tag> -> base64 webp). Built by tools/build_interactive_thumbnails.py from generated PNGs. The panel renders an empty '\uc900\ubc84 \uc911' cell for any tag missing from the pack, so a stale pack degrades gracefully instead of breaking the UI. The right-hand tag-dictionary aside additionally needs data/interactive_tags.json (declared bundled under prompt_tools): without it TagRelationRanker returns no implications/related, /api/tag/lookup omits those fields, and the aside renders empty with no error. That is exactly how it failed on 2026-07-30 - the file was absent from the portable build.",
      "paths": ["data/interactive_thumbnails.json"],
      "provisioning": "bundled"
    }
  ],
  "required_live_smoke": [
    "random prompt latency after warmup",
    "Generate dispatch with configured NovelAI/WebUI/ComfyUI or controlled test doubles",
    "Enhance",
    "img2img",
    "Vibe Transfer Storage",
    "Character Reference",
    "Automation start/stop with count and timer completion",
    "Artist Thumb random prompt and generate",
    "Danbooru internal post view and internal popup/browser handoff",
    "setup/API save and clear",
    "history save/delete/download",
    "data migration preview/import (loopback, temporary user-data)"
  ]
}
