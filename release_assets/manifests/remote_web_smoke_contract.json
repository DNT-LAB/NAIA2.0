              "expected_json_keys": ["state", "message"]
            }
          ]
        },
        {
          "name": "module_unknown_unavailable",
          "send_json": {
            "type": "get_module_state",
            "module_id": "__missing_module__"
          },
          "expected_messages": [
            {
              "type": "module_state",
              "expected_json_subset": {
                "module_id": "__missing_module__",
                "available": false,
                "runtime": "web"
              },
              "expected_json_keys": ["state"]
            }
          ]
