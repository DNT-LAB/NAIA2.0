  "legacy_dependency_policy": {
    "none": "Feature is implemented by the headless backend without desktop imports.",
    "legacy_compat": "Feature retains compatibility shims or legacy read fallbacks, but the supported headless path must not import PyQt6 or legacy_desktop.",
    "external": "Feature intentionally delegates to an external service or web site.",
    "needs_live_smoke": "Feature has a non-destructive route contract but still needs live endpoint or credential validation."
  },
  "smoke_levels": {
    "static": "Static file or mounted asset route.",
    "non_destructive": "Safe route check without external generation or destructive file operations.",
    "state_mutation": "Mutates server-owned state but should be safe with temporary user-data.",
    "asset_runtime": "Reads or writes runtime user assets.",
    "external_live": "Needs live configured NovelAI, WebUI, ComfyUI, or third-party endpoint validation."
  },
  "static_mounts": [
