{
  "version": 1,
  "status": "reviewed-round3",
  "purpose": "Classify large local files and user/runtime assets before Electron packaging or desktop-code deletion.",
  "decisions": [
    {
      "id": "random_prompt_runner_cache",
      "patterns": [
        "naia_temp_rows.parquet",
        "data/naia_temp_rows.parquet"
      ],
      "decision": "runtime_generated_cache",
      "runtime_destination": "cache/naia_temp_rows.parquet",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "naia_temp_rows.parquet"
      ],
      "owner": "app/backend/server/search_runtime.py",
      "notes": "Remote Web save_runner now writes through search_runtime to the runner parquet path owned by core/headless_search_state_service.py. Repository root/data copies remain read-only legacy fallbacks."
    },
    {
      "id": "artist_thumbnail_bundles",
      "patterns": [
        "data/artist_thumbnail.json",
        "data/artist_thumbnail_nai.json",
        "data/artist_thumbnail_anima.json"
      ],
      "decision": "runtime_downloaded_optional_bundle",
      "runtime_destination": "ui_assets/artist_thumb",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "data/artist_thumbnail*.json"
      ],
      "owner": "core/artist_thumbnail_service.py",
      "notes": "Large Artist Thumbnail dictionaries are downloaded or reused from runtime user data, with repository data files as legacy read fallbacks only."
    },
    {
      "id": "downloaded_tag_archives",
      "patterns": [
        "data/tags/**",
        "data/tagger/**"
      ],
      "decision": "runtime_downloaded_data",
      "runtime_destination": "data/tags",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "data/tags/**",
        "data/tagger/**"
      ],
      "owner": "core/runtime_install_manager.py",
      "notes": "Bulk Hugging Face tag archives are first-run/runtime data and must be installed into runtime user data, not bundled into the Electron package."
    },
    {
      "id": "event_preset_runtime_assets",
      "patterns": [
        "data/event_preset/naia_prompt_preset/**",
        "ui/event_preset/naia_prompt_preset/**",
        "data/event_preset_thumbnail"
      ],
      "decision": "runtime_downloaded_optional_bundle",
      "runtime_destination": "data/event_preset and ui_assets/event_preset_thumbnail",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "data/event_preset/**",
        "ui/event_preset/**",
        "data/event_preset_thumbnail"
      ],
      "owner": "core/event_preset_download_service.py",
      "notes": "Event Preset downloads now write to runtime data/ui_assets; legacy repository copies are read fallbacks."
    },
    {
      "id": "generated_tag_dictionaries",
      "patterns": [
        "result_dupl.py"
      ],
      "decision": "runtime_generated_index",
      "runtime_destination": "cache/tag_index",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "result_dupl.py"
      ],
      "owner": "core/kr_tag_loader.py",
      "notes": "Generated dictionaries that the runtime can rebuild or that are unused at runtime stay excluded. The three corpus dictionaries the tag-search index cannot rebuild on a clean machine (artist_dictionary/danbooru_character/result_dict_copyright) were reclassified into clean_machine_tag_dictionaries for the 2.0.2 parity restoration. data/e621_boost_static.py was moved to prompt_boost_static_data (include) once the e621 Auto-Boost feature was restored headless: it is a static lookup table the runtime loads, not a rebuildable index."
    },
    {
      "id": "prompt_boost_static_data",
      "patterns": [
        "data/e621_boost_static.py",
        "data/danbooru_tag_counts_by_rating.json"
      ],
      "decision": "bundle_source_bootstrap",
      "runtime_destination": "resource_root",
      "release_action": "include",
      "release_include_patterns": [
        "data/e621_boost_static.py",
        "data/danbooru_tag_counts_by_rating.json"
      ],
      "owner": "core/headless_prompt_boost_service.py",
      "notes": "Static lookup tables the e621 Auto-Boost (recommend_detailed) and Danbooru Auto-Weight (rating-conditional tag counts) features load at generation time from the resource root's data/ dir. They are not rebuildable on a clean machine and total ~2.9 MB, so they ship as read-only bootstrap data. Previously excluded as dead code (the desktop-only algorithms had no headless reach); bundling them is required now that the headless boost service drives both features."
    },
    {
      "id": "clean_machine_tag_dictionaries",
      "patterns": [
        "artist_dictionary.py",
        "danbooru_character.py",
        "result_dict_copyright.py"
      ],
      "decision": "bundle_source_bootstrap",
      "runtime_destination": "resource_root",
      "release_action": "include",
      "release_include_patterns": [
        "artist_dictionary.py",
        "danbooru_character.py",
        "result_dict_copyright.py"
      ],
      "owner": "release_assets/manifests/release_include_exclude_draft.json",
      "notes": "Prebuilt corpus dictionaries the TagSearchIndex consumes at load time. A clean machine has no way to regenerate them (the source corpus is not shipped), so the 2.0.2 parity restoration bundles them as read-only bootstrap data via the clean_machine_data include group. A later round may convert them to source data or a runtime-built cache; until then they are bundled, not excluded."
    },
    {
      "id": "root_image_samples",
      "patterns": [
        "00001.png",
        "20250827_*.png",
        "manual_*.png",
        "test*.png",
        "temp_image.png",
        "character_reference_*_result.png",
        "vibe_transfer_*_result.png",
        "stickman_canvas_tmp.webp"
      ],
      "decision": "local_sample_or_debug",
      "runtime_destination": "none",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "00001.png",
        "20250827_*.png",
        "manual_*.png",
        "test*.png",
        "temp_image.png",
        "character_reference_*_result.png",
        "vibe_transfer_*_result.png",
        "stickman_canvas_tmp.webp"
      ],
      "owner": "none",
      "notes": "Root-level generated images and debug samples are local artifacts only."
    },
    {
      "id": "vibe_transfer_files",
      "patterns": [
        "*.naiv4vibe",
        "*.naiv4vibebundle",
        "save/vibe_transfer/**",
        "save/vibe_transfer_clusters/**"
      ],
      "decision": "user_imported_runtime_asset",
      "runtime_destination": "save/vibe_transfer and save/vibe_transfer_clusters",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "*.naiv4vibe",
        "*.naiv4vibebundle",
        "save/vibe_transfer/**",
        "save/vibe_transfer_clusters/**"
      ],
      "owner": "core/headless_vibe_transfer_service.py",
      "notes": "Vibe files and encoded Vibe storage are user/imported runtime data. Headless storage reads runtime save roots and keeps repository save/ as a source-checkout migration fallback only."
    },
    {
      "id": "character_reference_storage",
      "patterns": [
        "save/character_reference/**"
      ],
      "decision": "runtime_user_state",
      "runtime_destination": "save/character_reference",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "save/character_reference/**"
      ],
      "owner": "core/headless_character_reference_service.py",
      "notes": "Character Reference images are stored under runtime save roots. Repository save/character_reference remains a source-checkout migration/read fallback and is disabled for Electron mode."
    },
    {
      "id": "local_state_and_outputs",
      "patterns": [
        "save/**",
        "logs/**",
        "output/**",
        "tmp/**",
        "tmp_codex_*/**",
        "htmlcov/**",
        ".coverage",
        ".coverage.*",
        ".cache/**",
        ".hypothesis/**",
        ".pytest_cache/**",
        "pytest-cache-files-*/**",
        "naia_headless_req_*/**",
        "__pycache__/**",
        "temp/**",
        "user-data/**"
      ],
      "decision": "runtime_user_state",
      "runtime_destination": "save/logs/output/cache/downloads/user-data",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "save/**",
        "logs/**",
        "output/**",
        "tmp/**",
        "tmp_codex_*/**",
        "htmlcov/**",
        ".coverage",
        ".coverage.*",
        ".cache/**",
        ".hypothesis/**",
        ".pytest_cache/**",
        "pytest-cache-files-*/**",
        "naia_headless_req_*/**",
        "__pycache__/**",
        "temp/**",
        "user-data/**"
      ],
      "owner": "app/backend/runtime/paths.py",
      "notes": "Mutable user state must remain outside bundled backend resources."
    },
    {
      "id": "user_wildcards",
      "patterns": [
        "wildcards/**"
      ],
      "decision": "runtime_user_state",
      "runtime_destination": "wildcards",
      "release_action": "exclude",
      "release_exclude_patterns": [
        "wildcards/**"
      ],
      "owner": "core/wildcard_manager.py",
      "notes": "User wildcard files are mutable runtime state. Packaged/headless runs read them from user-data/wildcards, while source checkouts keep the legacy repository wildcards fallback."
    },
    {
      "id": "bootstrap_source_assets",
      "patterns": [
        "app/web/remote/**",
        "workflows/**",
        "data/source/**",
        "data/clothes_list.txt",
        "data/color.txt",
        "data/characteristic_list.txt",
        "data/taglist/*.json"
      ],
      "decision": "bundle_source_bootstrap",
      "runtime_destination": "resource_root",
      "release_action": "include",
      "release_include_patterns": [
        "app/web/remote/**",
        "workflows/**",
        "data/source/**",
        "data/clothes_list.txt",
        "data/color.txt",
        "data/characteristic_list.txt",
        "data/taglist/*.json"
      ],
      "owner": "release_assets/manifests/release_include_exclude_draft.json",
      "notes": "Only immutable source/bootstrap assets are bundled by default. Runtime data is owned by the install manager."
    },
    {
      "id": "installer_seed_templates",
      "patterns": [
        "app_data_template/**",
        "release_assets/samples/**"
      ],
      "decision": "bundle_source_bootstrap",
      "runtime_destination": "user-data template/sample seed",
      "release_action": "include",
      "release_include_patterns": [
        "app_data_template/**",
        "release_assets/samples/**"
      ],
      "owner": "core/runtime_install_manager.py",
      "notes": "Initial Electron installs may ship only reviewed templates and small sample seed files. Operational tag data is downloaded into runtime user data."
    }
  ]
}
